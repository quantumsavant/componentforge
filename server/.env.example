# Copy this file to `.env` and fill in your values.
# Get the key from the Nebius Token Factory console.
NEBIUS_API_KEY=

# Pick ONE model id, copied verbatim from the Token Factory playground/catalog.
# Model IDs are CASE-SENSITIVE — a wrong-cased ID returns 404. Copy exactly.
# Verified 2026-10-16 against Nebius's official Token Factory cookbook:
# RECOMMENDED for ComponentForge (fastest + cheapest, good at code gen):
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Alternatives:
# nvidia/nemotron-3-super-120b-a12b      (smarter reasoning, costs more per call)
# nvidia/Nemotron-3-Ultra-550b-a55b      (flagship 550B, most expensive)
# nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B  (budget fallback)
# nvidia/Llama-3_1-Nemotron-Ultra-253B-v1 (NVIDIA-tuned Llama, 253B)

# Optional overrides
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
PORT=8787

# MOCK_MODE=true → no API key needed, no credits spent. The server returns a
# canned component so you can build + test the whole UI for free.
# Turn it off (or delete the line) when you add a real key for final testing.
# MOCK_MODE=true
