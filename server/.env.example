# Copy this file to `.env` and fill in your values.
# Get the key from the Nebius Token Factory console.
NEBIUS_API_KEY=

# Exact model id from the Token Factory playground/catalog, e.g. an nvidia/nemotron-* id.
# Copy it verbatim — do not guess. Confirm it in the playground first.
NEBIUS_MODEL=

# Optional overrides
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
PORT=8787

# MOCK_MODE=true → no API key needed, no credits spent. The server returns a
# canned component so you can build + test the whole UI for free.
# Turn it off (or delete the line) when you add a real key for final testing.
# MOCK_MODE=true
